# ---- Backend (Spring Boot) ----
DATABASE_URL=jdbc:postgresql://localhost:5432/craftora
DATABASE_USERNAME=craftora
DATABASE_PASSWORD=craftora
APP_PUBLIC_URL=http://localhost:3000        # used in e-mail links
APP_COOKIE_SECURE=false                      # true in production (HTTPS)
APP_MAKERS_AUTO_APPROVE=false                # true = skip manual maker approval
APP_ADMIN_EMAIL=admin@craftora.local         # first admin, created on startup
APP_ADMIN_PASSWORD=change-me-admin-password  # min 12 chars
APP_MAIL_MODE=log                            # log (sandbox) | smtp
APP_MAIL_FROM="Craftora <no-reply@craftora.example>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
APP_STORAGE_PROVIDER=local                   # local | s3
APP_STORAGE_LOCAL_ROOT=./data/uploads
S3_BUCKET=craftora
S3_REGION=eu-central-1
S3_ENDPOINT=                                 # e.g. MinIO / R2 endpoint; empty for AWS
S3_ACCESS_KEY=
S3_SECRET_KEY=
APP_DEV_OUTBOX=false                         # true ONLY for local E2E tests

# ---- Frontend (Next.js) ----
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Craftora
NEXT_PUBLIC_SUPPORT_EMAIL=hello@craftora.example
